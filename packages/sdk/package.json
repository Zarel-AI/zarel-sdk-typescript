{
    "name": "@zarel-ai/sdk",
    "version": "0.7.0",
    "description": "TypeScript SDK for the Zarel API",
    "license": "MIT",
    "author": {
        "name": "Nicolas Moreno",
        "url": "https://zarel.ai"
    },
    "homepage": "https://zarel.ai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Zarel-AI/zarel-sdk-typescript.git",
        "directory": "packages/sdk"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.js"
        },
        "./errors": {
            "types": "./dist/errors.d.ts",
            "import": "./dist/errors.js",
            "require": "./dist/errors.js"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.js",
            "require": "./dist/types/index.js"
        },
        "./resources": {
            "types": "./dist/resources/index.d.ts",
            "import": "./dist/resources/index.js",
            "require": "./dist/resources/index.js"
        },
        "./resources/*": {
            "types": "./dist/resources/*.d.ts",
            "import": "./dist/resources/*.js",
            "require": "./dist/resources/*.js"
        }
    },
    "typesVersions": {
        "*": {
            "client": [
                "dist/client.d.ts"
            ],
            "errors": [
                "dist/errors.d.ts"
            ],
            "types": [
                "dist/types/index.d.ts"
            ],
            "resources": [
                "dist/resources/index.d.ts"
            ],
            "resources/*": [
                "dist/resources/*.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepack": "npm run build",
        "build": "rm -rf dist && tsc",
        "test": "jest"
    },
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "zarel",
        "zarel-ai",
        "sdk",
        "api-client"
    ]
}
